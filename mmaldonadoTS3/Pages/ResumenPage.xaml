<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="mmaldonadoTS3.Pages.ResumenPage" Title="Resumen del contacto" BackgroundColor="#F4F7FB">
    <ContentPage.Resources><ResourceDictionary>
        <Style x:Key="SummaryHeading" TargetType="Label"><Setter Property="TextColor" Value="#172033"/><Setter Property="FontSize" Value="24"/><Setter Property="FontAttributes" Value="Bold"/></Style>
        <Style x:Key="FieldCaption" TargetType="Label"><Setter Property="TextColor" Value="#667085"/><Setter Property="FontSize" Value="12"/><Setter Property="CharacterSpacing" Value="0.5"/></Style>
        <Style x:Key="FieldValue" TargetType="Label"><Setter Property="TextColor" Value="#172033"/><Setter Property="FontSize" Value="16"/><Setter Property="FontAttributes" Value="Bold"/><Setter Property="LineBreakMode" Value="WordWrap"/></Style>
        <Style x:Key="ContributionValue" TargetType="Label" BasedOn="{StaticResource FieldValue}"><Setter Property="TextColor" Value="#225FE5"/><Setter Property="FontSize" Value="18"/></Style>
        <Style x:Key="ExportButton" TargetType="Button"><Setter Property="BackgroundColor" Value="#225FE5"/><Setter Property="TextColor" Value="White"/><Setter Property="FontAttributes" Value="Bold"/><Setter Property="FontSize" Value="16"/><Setter Property="CornerRadius" Value="14"/><Setter Property="HeightRequest" Value="54"/></Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ExportButton}"><Setter Property="BackgroundColor" Value="#E8EFFD"/><Setter Property="TextColor" Value="#225FE5"/></Style>
    </ResourceDictionary></ContentPage.Resources>
    <ScrollView><VerticalStackLayout Padding="22,20,22,30" Spacing="18">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10"><VerticalStackLayout Spacing="4" VerticalOptions="Center"><Label Text="RESUMEN" FontSize="12" FontAttributes="Bold" TextColor="#225FE5"/><Label Text="Contacto registrado" Style="{StaticResource SummaryHeading}"/></VerticalStackLayout><Image Grid.Column="1" Source="summary_hero.svg" WidthRequest="72" HeightRequest="72" Aspect="AspectFit" SemanticProperties.Description="Ilustración de un escudo de seguridad"/></Grid>
        <Border BackgroundColor="White" Stroke="#E5EAF2" StrokeThickness="1" StrokeShape="RoundRectangle 22" Padding="20"><VerticalStackLayout Spacing="14"><Label Text="DATOS PERSONALES" Style="{StaticResource FieldCaption}"/><Grid ColumnDefinitions="*,*" ColumnSpacing="12" RowSpacing="14">
            <VerticalStackLayout Spacing="3"><Label Text="Identificación" Style="{StaticResource FieldCaption}"/><Label x:Name="IdentificacionLabel" Style="{StaticResource FieldValue}"/></VerticalStackLayout><VerticalStackLayout Grid.Column="1" Spacing="3"><Label Text="Fecha" Style="{StaticResource FieldCaption}"/><Label x:Name="FechaLabel" Style="{StaticResource FieldValue}"/></VerticalStackLayout>
            <VerticalStackLayout Grid.Row="1" Spacing="3"><Label Text="Nombres" Style="{StaticResource FieldCaption}"/><Label x:Name="NombresLabel" Style="{StaticResource FieldValue}"/></VerticalStackLayout><VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="3"><Label Text="Apellidos" Style="{StaticResource FieldCaption}"/><Label x:Name="ApellidosLabel" Style="{StaticResource FieldValue}"/></VerticalStackLayout>
            <VerticalStackLayout Grid.Row="2" Grid.ColumnSpan="2" Spacing="3"><Label Text="Correo" Style="{StaticResource FieldCaption}"/><Label x:Name="CorreoLabel" Style="{StaticResource FieldValue}"/></VerticalStackLayout>
        </Grid></VerticalStackLayout></Border>
        <Border BackgroundColor="#EDF4FF" Stroke="#D6E5FF" StrokeThickness="1" StrokeShape="RoundRectangle 22" Padding="20"><VerticalStackLayout Spacing="14"><Label Text="CÁLCULO DEL APORTE" Style="{StaticResource FieldCaption}"/>
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="12"><Label Text="Salario mensual" Style="{StaticResource FieldValue}"/><Label x:Name="SalarioLabel" Grid.Column="1" Style="{StaticResource FieldValue}" HorizontalTextAlignment="End"/><Label Grid.Row="1" Text="Aporte personal IESS (9,45 %)" Style="{StaticResource FieldValue}"/><Label x:Name="AportePersonalLabel" Grid.Row="1" Grid.Column="1" Style="{StaticResource ContributionValue}" HorizontalTextAlignment="End"/><Label Grid.Row="2" Text="Salario luego del aporte personal" Style="{StaticResource FieldValue}"/><Label x:Name="NetoLabel" Grid.Row="2" Grid.Column="1" Style="{StaticResource ContributionValue}" HorizontalTextAlignment="End"/></Grid>
            <BoxView HeightRequest="1" Color="#D6E5FF"/><Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><Label Text="Aporte patronal referencial (11,15 %)" Style="{StaticResource FieldCaption}" VerticalTextAlignment="Center"/><Label x:Name="AportePatronalLabel" Grid.Column="1" Style="{StaticResource FieldValue}" FontSize="14" HorizontalTextAlignment="End"/></Grid>
            <Label Text="Cálculo referencial para trabajador del sector privado bajo relación de dependencia. El aporte personal se descuenta del salario; el patronal lo asume el empleador." FontSize="12" TextColor="#526174"/>
        </VerticalStackLayout></Border>
        <Button Text="Exportar resumen a .txt" Style="{StaticResource ExportButton}" Clicked="Exportar_Clicked"/><Button Text="Registrar otro contacto" Style="{StaticResource SecondaryButton}" Clicked="NuevoContacto_Clicked"/>
    </VerticalStackLayout></ScrollView>
</ContentPage>